# =============================================================================
# REDIS INITIALIZATION COMMANDS — POPSMARKET
# =============================================================================
# Executado pelo iniciar.sh assim que o container do Redis responde ao PING.
# Padrão de nomes das chaves: popsmarket:<entidade>:<id>
# =============================================================================

# 1. Configurações globais da aplicacao (Estrutura: Hash)
HSET popsmarket:config:app versao "2.0.0" ambiente "desenvolvimento" moeda "BRL" cidade "Guarapuava" frete_gratis_acima "299.90"

# 2. Conjunto de categorias ativas do marketplace (Estrutura: Set)
SADD popsmarket:categorias:ativas "Eletrônicos" "Informática" "Notebooks" "Celulares" "Áudio" "Casa" "Móveis" "Escritório" "Decoração" "Iluminação" "Moda" "Calçados" "Acessórios" "Esportes" "Fitness"

# 3. Ranking de produtos mais vendidos para a vitrine da home (Estrutura: Sorted Set)
ZADD popsmarket:ranking:produtos 320 "Fone de Ouvido Bluetooth JBL Tune 520"
ZADD popsmarket:ranking:produtos 210 "Smartphone Samsung Galaxy A54"
ZADD popsmarket:ranking:produtos 145 "Tênis Casual Masculino"
ZADD popsmarket:ranking:produtos 98 "Notebook Lenovo IdeaPad 3"
ZADD popsmarket:ranking:produtos 64 "Kit Halteres Ajustáveis 20kg"

# 4. Contador global de visitas à vitrine (Estrutura: String/Integer)
SET popsmarket:stats:visitas:total 1000
