# Redis - Projeto Bora Lá

# Informações simples da aplicação
HSET config:app nome "Bora La" versao "1.0.0" ambiente "desenvolvimento" cidade "Guarapuava"

# Status permitidos para as corridas
SADD corridas:status "aguardando_motorista" "aceita" "em_andamento" "finalizada" "cancelada"

# Contador inicial apenas para exemplo de uso do Redis
SET stats:corridas:consultas 0
