{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "analysis": {
      "analyzer": {
        "texto_ptbr": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": [
            "lowercase",
            "asciifolding"
          ]
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "corrida_id": {
        "type": "keyword"
      },
      "passageiro_id": {
        "type": "keyword"
      },
      "motorista_id": {
        "type": "keyword"
      },
      "origem": {
        "type": "text",
        "analyzer": "texto_ptbr"
      },
      "destino": {
        "type": "text",
        "analyzer": "texto_ptbr"
      },
      "status": {
        "type": "keyword"
      },
      "valor_estimado": {
        "type": "float"
      },
      "distancia_estimada_km": {
        "type": "float"
      },
      "data_solicitacao": {
        "type": "date"
      }
    }
  }
}
